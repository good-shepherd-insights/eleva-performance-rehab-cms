# Public CMS origin, used for CMS URLs, CORS, and CSRF
CMS_ORIGIN=http://localhost:3000

# Public website origin, used for Live Preview, CORS, and CSRF
SITE_ORIGIN=http://localhost:4321

# Identifier for the shared site global
SITE_GLOBAL_SLUG=site-globals

# JSON array of locale objects with code, label, and optional rtl
CMS_LOCALES=[{"code":"en","label":"English"}]

# Locale code from CMS_LOCALES used as the default locale
CMS_DEFAULT_LOCALE=en

# MongoDB connection string (database name in the path)
MONGODB_URL=

# Secret used to sign Payload sessions and tokens
PAYLOAD_SECRET=

# Vercel Blob token for media storage
BLOB_READ_WRITE_TOKEN=

# Set to true to mount the inline click-to-edit Live Preview bridge
ENABLE_INLINE_EDIT_BRIDGE=false

# Optional endpoint called when a pages document is published
WEBSITE_DEPLOY_WEBHOOK_URL=
